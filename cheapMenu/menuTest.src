#include "menu.gs"

tests = []
choices = []
for idx in range(10)
    act = function()
        print(__idx_idx + " <----> Success")
        wait(2.5)
    end function
    x = Choice.make(__idx_idx + " < Print",@act)
    choices.push(x)
end for
tests.push(Menu.make(choices,"test0"))

